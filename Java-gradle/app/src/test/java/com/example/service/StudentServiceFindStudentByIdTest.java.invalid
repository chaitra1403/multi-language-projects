package com.example.service;import com.example.model.Student;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import java.util.List;
import java.util.ArrayList;
import org.junit.jupiter.api.*;

public class StudentServiceFindStudentByIdTest {
    private StudentService studentService;
    @BeforeEach
    public void setUp() {
        studentService = new StudentService();
    }
    @Test
    @Tag("valid")
    public void findStudentByValidId() {
        Student student = new Student(1, "John Doe", 20); // Adjusted constructor parameters
        studentService.addStudent(student);
        Student result = studentService.findStudentById(1);
        assertNotNull(result, "The student should not be null");
        assertEquals(1, result.getId(), "The student ID should match the expected value");
    }
    @Test
    @Tag("invalid")
    public void findStudentByInvalidId() {
        Student student = new Student(1, "John Doe", 20); // Adjusted constructor parameters
        studentService.addStudent(student);
        Student result = studentService.findStudentById(2);
        assertNull(result, "The student should be null for an invalid ID");
    }
    @Test
    @Tag("boundary")
    public void findStudentInEmptyList() {
        Student result = studentService.findStudentById(1);
        assertNull(result, "The student should be null when the list is empty");
    }
    @Test
    @Tag("valid")
    public void findStudentWithMultipleStudents() {
        Student student1 = new Student(1, "John Doe", 20); // Adjusted constructor parameters
        Student student2 = new Student(2, "Jane Doe", 22); // Adjusted constructor parameters
        studentService.addStudent(student1);
        studentService.addStudent(student2);
        Student result = studentService.findStudentById(2);
        assertNotNull(result, "The student should not be null");
        assertEquals(2, result.getId(), "The student ID should match the expected value");
    }
    @Test
    @Tag("boundary")
    public void findStudentWithDuplicateIds() {
        Student student1 = new Student(1, "John Doe", 20); // Adjusted constructor parameters
        Student student2 = new Student(1, "Jane Doe", 22); // Adjusted constructor parameters
        studentService.addStudent(student1);
        studentService.addStudent(student2);
        Student result = studentService.findStudentById(1);
        assertNotNull(result, "The student should not be null");
        assertEquals("John Doe", result.getName(), "The student name should match the first occurrence");
    }
}