package com.example.service;import com.example.model.Student;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.*;

public class StudentServiceFindStudentByIdTest {
    private StudentService studentService;
    @BeforeEach
    public void setUp() {
        studentService = new StudentService();
    }
    @Test
    @Tag("valid")
    public void findStudentByValidId() {
        // Arrange
        Student student = new Student(1, "John Doe", 20); // Ensure Student class has this constructor
        studentService.addStudent(student);
        // Act
        Student result = studentService.findStudentById(1);
        // Assert
        assertNotNull(result, "Expected student to be found");
        assertEquals((int)1, (int)result.getId(), "Expected student ID to match");
    }
    @Test
    @Tag("invalid")
    public void findStudentByInvalidId() {
        // Arrange
        Student student = new Student(1, "John Doe", 20); // Ensure Student class has this constructor
        studentService.addStudent(student);
        // Act
        Student result = studentService.findStudentById(2);
        // Assert
        assertNull(result, "Expected no student to be found");
    }
    @Test
    @Tag("boundary")
    public void findStudentInEmptyList() {
        // Act
        Student result = studentService.findStudentById(1);
        // Assert
        assertNull(result, "Expected no student to be found in an empty list");
    }
    @Test
    @Tag("valid")
    public void findStudentWithMultipleEntries() {
        // Arrange
        Student student1 = new Student(1, "John Doe", 20);
        Student student2 = new Student(2, "Jane Doe", 22);
        studentService.addStudent(student1);
        studentService.addStudent(student2);
        // Act
        Student result = studentService.findStudentById(2);
        // Assert
        assertNotNull(result, "Expected student to be found");
        assertEquals((int)2, (int)result.getId(), "Expected student ID to match");
    }
    @Test
    @Tag("boundary")
    public void findStudentWithDuplicateIds() {
        // Arrange
        Student student1 = new Student(1, "John Doe", 20);
        Student student2 = new Student(1, "Jane Doe", 22);
        studentService.addStudent(student1);
        studentService.addStudent(student2);
        // Act
        Student result = studentService.findStudentById(1);
        // Assert
        assertNotNull(result, "Expected student to be found");
        assertEquals("John Doe", result.getName(), "Expected first student with duplicate ID to be returned");
    }
}