package com.example.service;import com.example.model.Student;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import java.util.ArrayList;

class StudentServiceGetAllStudentsTest {
    private StudentService studentService;
    @BeforeEach
    void setUp() {
        studentService = new StudentService();
    }
    @Test
    @Tag("valid")
    public void getAllStudentsReturnsEmptyListWhenNoStudentsAdded() {
        List<Student> students = studentService.getAllStudents();
        assertTrue(students.isEmpty(), "The list should be empty when no students have been added.");
    }
    @Test
    @Tag("valid")
    public void getAllStudentsReturnsListOfAllAddedStudents() {
        Student student1 = new Student(1, "John Doe", 20); // Updated constructor parameters
        Student student2 = new Student(2, "Jane Doe", 22); // Updated constructor parameters
        studentService.addStudent(student1);
        studentService.addStudent(student2);
        List<Student> students = studentService.getAllStudents();
        assertEquals(2, students.size(), "The list should contain all added students.");
        assertTrue(students.contains(student1), "The list should contain student1.");
        assertTrue(students.contains(student2), "The list should contain student2.");
    }
    @Test
    @Tag("valid")
    public void getAllStudentsReturnsListWithCorrectOrder() {
        Student student1 = new Student(1, "John Doe", 20); // Updated constructor parameters
        Student student2 = new Student(2, "Jane Doe", 22); // Updated constructor parameters
        studentService.addStudent(student1);
        studentService.addStudent(student2);
        List<Student> students = studentService.getAllStudents();
        assertEquals(student1, students.get(0), "The first student should be student1.");
        assertEquals(student2, students.get(1), "The second student should be student2.");
    }
    @Test
    @Tag("boundary")
    public void getAllStudentsHandlesLargeNumberOfStudents() {
        for (int i = 0; i < 1000; i++) {
            studentService.addStudent(new Student(i, "Student " + i, 18)); // Updated constructor parameters
        }
        List<Student> students = studentService.getAllStudents();
        assertEquals(1000, students.size(), "The list should contain 1000 students.");
    }
    @Test
    @Tag("valid")
    public void getAllStudentsReturnsModifiableList() {
        Student student1 = new Student(1, "John Doe", 20); // Updated constructor parameters
        studentService.addStudent(student1);
        List<Student> students = studentService.getAllStudents();
        students.add(new Student(2, "Jane Doe", 22)); // Updated constructor parameters
        assertEquals(2, students.size(), "The list should be modifiable and contain 2 students.");
    }
}