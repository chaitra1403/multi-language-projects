package com.example.model;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class StudentToStringTest {
    @Test
    @Tag("valid")
    public void toStringWithValidData() {
        // Arrange
        Student student = new Student(1, "John Doe", 20);
        
        // Act
        String result = student.toString();
        
        // Assert
        assertEquals("ID: 1, Name: John Doe, Age: 20", result);
    }
    
    @Test
    @Tag("valid")
    public void toStringWithEmptyName() {
        // Arrange
        Student student = new Student(2, "", 25);
        
        // Act
        String result = student.toString();
        
        // Assert
        assertEquals("ID: 2, Name: , Age: 25", result);
    }
    
    @Test
    @Tag("boundary")
    public void toStringWithZeroAge() {
        // Arrange
        Student student = new Student(3, "Alice", 0);
        
        // Act
        String result = student.toString();
        
        // Assert
        assertEquals("ID: 3, Name: Alice, Age: 0", result);
    }
    
    @Test
    @Tag("invalid")
    public void toStringWithNegativeId() {
        // Arrange
        Student student = new Student(-1, "Bob", 18);
        
        // Act
        String result = student.toString();
        
        // Assert
        assertEquals("ID: -1, Name: Bob, Age: 18", result);
    }
    
    @Test
    @Tag("boundary")
    public void toStringWithMaxIntegerValues() {
        // Arrange
        Student student = new Student(Integer.MAX_VALUE, "Max", Integer.MAX_VALUE);
        
        // Act
        String result = student.toString();
        
        // Assert
        assertEquals("ID: 2147483647, Name: Max, Age: 2147483647", result);
    }
}