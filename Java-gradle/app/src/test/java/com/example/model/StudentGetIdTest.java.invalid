package com.example.model;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class StudentGetIdTest {
    @Test
    @Tag("valid")
    public void retrieveIdForValidStudent() {
        // Arrange
        Student student = new Student(1, "John Doe", 20);
        
        // Act
        int actualId = student.getId();
        
        // Assert
        assertEquals(1, actualId);
    }
    @Test
    @Tag("invalid")
    public void retrieveIdForStudentWithNegativeId() {
        // Arrange
        Student student = new Student(-1, "Jane Doe", 22);
        
        // Act
        int actualId = student.getId();
        
        // Assert
        assertEquals(-1, actualId);
    }
    @Test
    @Tag("boundary")
    public void retrieveIdForStudentWithZeroId() {
        // Arrange
        Student student = new Student(0, "Alice Smith", 19);
        
        // Act
        int actualId = student.getId();
        
        // Assert
        assertEquals(0, actualId);
    }
    @Test
    @Tag("boundary")
    public void retrieveIdForStudentWithLargePositiveId() {
        // Arrange
        Student student = new Student(1000000, "Bob Brown", 21);
        
        // Act
        int actualId = student.getId();
        
        // Assert
        assertEquals(1000000, actualId);
    }
    @Test
    @Tag("boundary")
    public void retrieveIdForStudentWithMaxIntegerId() {
        // Arrange
        Student student = new Student(Integer.MAX_VALUE, "Charlie Green", 23);
        
        // Act
        int actualId = student.getId();
        
        // Assert
        assertEquals(Integer.MAX_VALUE, actualId);
    }
}