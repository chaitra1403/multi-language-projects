package com.example.model;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;

public class StudentGetNameTest {
    @Test
    @Tag("valid")
    public void getNameReturnsCorrectName() {
        // Arrange
        Student student = new Student(1, "John Doe", 20);
        
        // Act
        String actualName = student.getName();
        
        // Assert
        assertEquals("John Doe", actualName);
    }
    
    @Test
    @Tag("boundary")
    public void getNameHandlesEmptyName() {
        // Arrange
        Student student = new Student(2, "", 21);
        
        // Act
        String actualName = student.getName();
        
        // Assert
        assertEquals("", actualName);
    }
    
    @Test
    @Tag("invalid")
    public void getNameHandlesNullName() {
        // Arrange
        Student student = new Student(3, null, 22);
        
        // Act
        String actualName = student.getName();
        
        // Assert
        assertNull(actualName);
    }
    
    @Test
    @Tag("valid")
    public void getNameWithSpecialCharacters() {
        // Arrange
        Student student = new Student(4, "John@Doe!", 23);
        
        // Act
        String actualName = student.getName();
        
        // Assert
        assertEquals("John@Doe!", actualName);
    }
    
    @Test
    @Tag("boundary")
    public void getNameWithLongName() {
        // Arrange
        String longName = "a".repeat(1000); // Adjusted length if needed
        Student student = new Student(5, longName, 24);
        
        // Act
        String actualName = student.getName();
        
        // Assert
        assertEquals(longName, actualName);
    }
}