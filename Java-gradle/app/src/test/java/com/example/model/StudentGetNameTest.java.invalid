package com.example.model;import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;

public class StudentGetNameTest {
    @Test
    @Tag("valid")
    public void getNameReturnsCorrectName() {
        // Arrange
        Student student = new Student(1, "John Doe", 20);
        // Act
        String actualName = student.getName();
        // Assert
        assertEquals("John Doe", actualName);
    }
    @Test
    @Tag("boundary")
    public void getNameReturnsEmptyString() {
        // Arrange
        Student student = new Student(2, "", 22);
        // Act
        String actualName = student.getName();
        // Assert
        assertEquals("", actualName);
    }
    @Test
    @Tag("invalid")
    public void getNameReturnsNull() {
        // Arrange
        Student student = new Student(3, null, 25);
        // Act
        String actualName = student.getName();
        // Assert
        assertNull(actualName);
    }
    @Test
    @Tag("valid")
    public void getNameHandlesSpecialCharacters() {
        // Arrange
        Student student = new Student(4, "Élise-Marie", 23);
        // Act
        String actualName = student.getName();
        // Assert
        assertEquals("Élise-Marie", actualName);
    }
    @Test
    @Tag("valid")
    public void getNameReturnsNameWithNumbers() {
        // Arrange
        Student student = new Student(5, "John123", 21);
        // Act
        String actualName = student.getName();
        // Assert
        assertEquals("John123", actualName);
    }
}