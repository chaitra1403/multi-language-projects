package com.example.model;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class StudentGetAgeTest {
    @Test
    @Tag("valid")
    public void verifyCorrectAgeIsReturned() {
        // Arrange
        Student student = new Student(1, "John Doe", 20);
        
        // Act
        int actualAge = student.getAge();
        
        // Assert
        assertEquals(20, actualAge);
    }
    
    @Test
    @Tag("valid")
    public void verifyAgeIsReturnedAsInteger() {
        // Arrange
        Student student = new Student(2, "Jane Doe", 25);
        
        // Act
        int actualAge = student.getAge();
        
        // Assert
        assertTrue(Integer.valueOf(actualAge) instanceof Integer);
    }
    
    @Test
    @Tag("boundary")
    public void verifyAgeWithMinimumIntegerValue() {
        // Arrange
        Student student = new Student(3, "Min Int", Integer.MIN_VALUE);
        
        // Act
        int actualAge = student.getAge();
        
        // Assert
        assertEquals(Integer.MIN_VALUE, actualAge);
    }
    
    @Test
    @Tag("boundary")
    public void verifyAgeWithMaximumIntegerValue() {
        // Arrange
        Student student = new Student(4, "Max Int", Integer.MAX_VALUE);
        
        // Act
        int actualAge = student.getAge();
        
        // Assert
        assertEquals(Integer.MAX_VALUE, actualAge);
    }
    
    @Test
    @Tag("boundary")
    public void verifyAgeWithZeroValue() {
        // Arrange
        Student student = new Student(5, "Zero Age", 0);
        
        // Act
        int actualAge = student.getAge();
        
        // Assert
        assertEquals(0, actualAge);
    }
}