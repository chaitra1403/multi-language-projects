        // Arrange
        Student student = new Student(2, "Jane Doe", 0);
        // Act
        int actualAge = student.getAge();
        // Assert
        assertEquals(0, actualAge);
    }
    
    @Test
    @Tag("boundary")
    public void testGetAgeWithMaximumReasonableAge() {
        // Arrange
        Student student = new Student(3, "Max Age", 120);
        // Act
        int actualAge = student.getAge();
        // Assert
