import os
import shutil
import pytest
from unittest.mock import patch, call
from python-file-organizer.organizer.file_handler import organize_folder

FOLDERS = {
    'images': ['.jpg', '.png', '.jpeg'],
    'documents': ['.pdf', '.txt', '.docx'],
    'code': ['.py', '.java', '.cpp'],
    'archives': ['.zip', '.rar']
}

class Test_FileHandlerOrganizeFolder:

    @pytest.mark.invalid
    def test_path_does_not_exist(self, capsys):
        # Arrange
        non_existent_path = "/path/does/not/exist"  # TODO: Change this to a non-existent path on your system

        # Act
        organize_folder(non_existent_path)

        # Assert
        captured = capsys.readouterr()
        assert "Path does not exist!" in captured.out

    @pytest.mark.positive
    def test_organize_files_into_correct_folders(self, tmpdir):
        # Arrange
        temp_dir = tmpdir.mkdir("test_dir")
        files = {
            "image1.jpg": "images",
            "document1.pdf": "documents",
            "script.py": "code",
            "archive.zip": "archives"
        }
        for file_name in files.keys():
            temp_dir.join(file_name).write("content")

        # Act
        organize_folder(str(temp_dir))

        # Assert
        for file_name, folder in files.items():
            assert os.path.exists(os.path.join(temp_dir, folder, file_name))

    @pytest.mark.positive
    def test_move_files_to_others_folder(self, tmpdir):
        # Arrange
        temp_dir = tmpdir.mkdir("test_dir")
        files = ["unknown.xyz", "another.abc"]
        for file_name in files:
            temp_dir.join(file_name).write("content")

        # Act
        organize_folder(str(temp_dir))

        # Assert
        for file_name in files:
            assert os.path.exists(os.path.join(temp_dir, "others", file_name))

    @pytest.mark.positive
    def test_handle_empty_directory(self, tmpdir):
        # Arrange
        temp_dir = tmpdir.mkdir("test_dir")

        # Act
        organize_folder(str(temp_dir))

        # Assert
        assert len(os.listdir(temp_dir)) == 0

    @pytest.mark.positive
    def test_handle_files_with_no_extension(self, tmpdir):
        # Arrange
        temp_dir = tmpdir.mkdir("test_dir")
        files = ["file1", "file2"]
        for file_name in files:
            temp_dir.join(file_name).write("content")

        # Act
        organize_folder(str(temp_dir))

        # Assert
        for file_name in files:
            assert os.path.exists(os.path.join(temp_dir, "others", file_name))

    @pytest.mark.positive
    def test_ensure_existing_folders_are_not_overwritten(self, tmpdir):
        # Arrange
        temp_dir = tmpdir.mkdir("test_dir")
        existing_folders = ["images", "documents", "code", "archives", "others"]
        for folder in existing_folders:
            temp_dir.mkdir(folder)
        files = {
            "image1.jpg": "images",
            "document1.pdf": "documents",
            "script.py": "code",
            "archive.zip": "archives",
            "unknown.xyz": "others"
        }
        for file_name in files.keys():
            temp_dir.join(file_name).write("content")

        # Act
        organize_folder(str(temp_dir))

        # Assert
        for file_name, folder in files.items():
            assert os.path.exists(os.path.join(temp_dir, folder, file_name))
